# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Server
PORT=8080
NODE_ENV=production

# JWT
JWT_SECRET=your-secret-key-here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token
# Для кнопок подтверждения заказов в боте — chat_id админа и его пароль от сайта
TELEGRAM_CHAT_ID=your-admin-chat-id
BOT_ADMIN_PASSWORD=admin-password

# API URL for bot
API_URL=https://your-app.railway.app

# Frontend URL (для ссылок в боте при /start)
FRONTEND_URL=https://vape-shopby.netlify.app

# Email (Resend - required for auth codes)
RESEND_API_KEY=re_xxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=VapeShop <onboarding@resend.dev>
