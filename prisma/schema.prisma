generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String
  name            String
  telegram        String?
  telegramChatId  BigInt?   @unique  // Telegram user id (может быть > 2^31, поэтому BigInt)
  phone           String?
  role            Role      @default(USER)
  orders          Order[]
  createdAt       DateTime  @default(now())
}

model Product {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  price       Float
  costPrice   Float
  imageUrl    String
  category    String
  quantity    Int
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELED
}

model PickupLocation {
  id      Int     @id @default(autoincrement())
  name    String
  address String
  active  Boolean @default(true)
  orders  Order[]
}

model Order {
  id               Int            @id @default(autoincrement())
  userId           Int
  user             User           @relation(fields: [userId], references: [id])

  pickupLocationId Int?
  pickupLocation   PickupLocation? @relation(fields: [pickupLocationId], references: [id], onDelete: SetNull)
  pickupLocationName   String     @default("")  // снимок на момент заказа
  pickupLocationAddress String?   // снимок адреса

  pickupTime       DateTime?      // опционально
  totalPrice       Float
  status           String         @default("PENDING")

  telegramChatId    BigInt?       // chat.id (Telegram ID может быть > 2^31)
  telegramMessageId BigInt?       // message_id
  changeFrom        Float?         // сдача

  items            OrderItem[]
  createdAt        DateTime       @default(now())
}


model OrderItem {
  id             Int     @id @default(autoincrement())

  order          Order   @relation(fields: [orderId], references: [id])
  orderId        Int

  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId      Int?

  productTitle     String  @default("")  // снимок на момент заказа (история не меняется при редактировании товара)
  productImageUrl  String?              // снимок изображения
  productDescription String?            // снимок описания

  quantity         Int
  price            Float
}

